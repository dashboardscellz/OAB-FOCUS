{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin' || (auth.uid === $uid && !data.exists() && auth.token.email === 'manasses@oabfocus.app' && newData.child('role').val() === 'admin'))"
        },
        "progress": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin')"
        }
      }
    }
  }
}
