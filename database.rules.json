{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin' && root.child('users').child(auth.uid).child('profile').child('active').val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin' && root.child('users').child(auth.uid).child('profile').child('active').val() === true))",
        "profile": {
          ".write": "auth != null && ((root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin' && root.child('users').child(auth.uid).child('profile').child('active').val() === true) || (auth.uid === $uid && ((!data.exists() && ((auth.token.email === 'manasses@oabfocus.app' && newData.child('role').val() === 'admin' && newData.child('active').val() === true) || (newData.child('role').val() === 'student' && newData.child('active').val() === false && newData.child('approvalStatus').val() === 'pending'))) || (data.exists() && !newData.exists()) || (data.exists() && newData.child('role').val() === data.child('role').val() && newData.child('active').val() === data.child('active').val() && newData.child('approvalStatus').val() === data.child('approvalStatus').val() && newData.child('username').val() === data.child('username').val()))))",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120"
          },
          "username": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80"
          },
          "role": {
            ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'student')"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "approvalStatus": {
            ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected')"
          }
        },
        "progress": {
          ".write": "auth != null && ((auth.uid === $uid && root.child('users').child($uid).child('profile').child('active').val() === true && root.child('users').child($uid).child('profile').child('approvalStatus').val() !== 'pending' && root.child('users').child($uid).child('profile').child('approvalStatus').val() !== 'rejected') || (root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin' && root.child('users').child(auth.uid).child('profile').child('active').val() === true))"
        }
      }
    },
    "leaderboard": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('profile').child('active').val() === true && root.child('users').child(auth.uid).child('profile').child('approvalStatus').val() !== 'pending' && root.child('users').child(auth.uid).child('profile').child('approvalStatus').val() !== 'rejected'",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && root.child('users').child($uid).child('profile').child('active').val() === true && root.child('users').child($uid).child('profile').child('approvalStatus').val() !== 'pending' && root.child('users').child($uid).child('profile').child('approvalStatus').val() !== 'rejected') || (root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin' && root.child('users').child(auth.uid).child('profile').child('active').val() === true))"
      }
    }
  }
}
